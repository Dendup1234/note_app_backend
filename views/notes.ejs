<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Notes</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Quick minimal styling; remove if you have your own CSS -->
    <link rel="stylesheet" href="https://unpkg.com/mvp.css" />
  </head>
  <body>
    <main class="row">
      <nav style="display: flex; align-items: center">
        <a href="/auth/logout">Logout</a>
      </nav>
      <!-- Create form -->
      <div>
        <h2>Add a note</h2>
      </div>
      <br />
      <div>
        <form method="post" action="/notes">
          <label
            >Title
            <input type="text" name="title" required />
          </label>

          <label
            >Description
            <textarea name="description" rows="4" required></textarea>
          </label>

          <label style="display: flex; align-items: center; gap: 0.5rem">
            <input type="checkbox" name="isCompleted" value="true" />
            Mark as completed
          </label>

          <button type="submit">Create Note</button>
        </form>
      </div>

      <!-- List notes -->
      <h2>All notes</h2>

      <% if (Array.isArray(notes) && notes.length) { %>
      <div class="note-list" style="display: grid; gap: 1rem">
        <% notes.forEach(n => { %>
        <article class="note-card">
          <div class="note-head">
            <h3 style="margin: 0"><%= n.title %></h3>
            <span class="badge <%= n.isCompleted ? 'ok' : 'no' %>">
              <%= n.isCompleted ? 'Completed' : 'Not completed' %>
            </span>
          </div>

          <% if (n.description) { %>
          <p><%= n.description %></p>
          <% } %> <% if (n.image) { %>
          <img
            class="thumb"
            src="<%= n.image %>"
            alt="note image"
            loading="lazy"
          />
          <% } %>

          <p class="muted">
            #<%= n._id %> • created <%= new Date(n.createdAt).toLocaleString()
            %> <% if (n.updatedAt && n.updatedAt !== n.createdAt) { %> • updated
            <%= new Date(n.updatedAt).toLocaleString() %> <% } %>
          </p>
        </article>
        <% }) %>
      </div>
      <% } else { %>
      <p class="muted">No notes yet — add one on the left.</p>
      <% } %>
    </main>
  </body>
</html>
