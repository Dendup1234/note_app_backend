<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Notes</title>
  </head>
  <body>
    <h1>Notes</h1>
    <a href="/auth/logout">Logout</a>

    <h2>Add a Note</h2>
    <form method="POST" action="/notes">
      <label>Title: <input type="text" name="title" required /></label><br />
      <label
        >Description: <textarea name="description" required></textarea></label
      ><br />
      <label>
        Completed:
        <input type="checkbox" name="isCompleted" value="true" /> </label
      ><br />
      <button type="submit">Add</button>
    </form>

    <hr />

    <h2>All Notes</h2>
    <ul>
      <% notes.forEach(n => { %>
      <li>
        <b><%= n.title %></b> - <%= n.description %> (<%= n.isCompleted ?
        "Completed" : "Not Completed" %>)
        <br />

        <button
          type="button"
          class="edit-btn"
          data-id="<%= n._id %>"
          data-title="<%- n.title %>"
          data-description="<%- n.description %>"
          data-completed="<%= n.isCompleted %>"
        >
          Update
        </button>

        <form
          action="/notes/<%= n._id %>?_method=DELETE"
          method="POST"
          style="display: inline"
          onsubmit="return confirm('Delete this note?');"
        >
          <button type="submit">Delete</button>
        </form>
      </li>
      <br />
      <% }) %>
    </ul>

    <!-- Simple update dialog -->
    <dialog id="editDialog">
      <form id="editForm" method="POST">
        <input type="hidden" name="_method" value="PUT" />
        <h3>Update Note</h3>

        <label
          >Title:
          <input type="text" name="title" id="editTitle" required /></label
        ><br />
        <label
          >Description:
          <textarea
            name="description"
            id="editDescription"
            required
          ></textarea></label
        ><br />
        <label>
          Completed:
          <input
            type="checkbox"
            name="isCompleted"
            id="editCompleted"
          /> </label
        ><br />

        <button type="submit">Save</button>
        <button type="button" id="cancelBtn">Cancel</button>
      </form>
    </dialog>

    <script>
      const dialog = document.getElementById("editDialog");
      const form = document.getElementById("editForm");
      const titleInput = document.getElementById("editTitle");
      const descInput = document.getElementById("editDescription");
      const completedInput = document.getElementById("editCompleted");
      const cancelBtn = document.getElementById("cancelBtn");

      document.querySelectorAll(".edit-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.dataset.id;
          titleInput.value = btn.dataset.title;
          descInput.value = btn.dataset.description;
          completedInput.checked = btn.dataset.completed === "true";
          form.action = `/notes/${id}?_method=PUT`;
          dialog.showModal();
        });
      });

      cancelBtn.addEventListener("click", () => {
        dialog.close();
      });
    </script>
  </body>
</html>
